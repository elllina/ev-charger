# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ev_charging
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ev_charging

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-very-long-and-secure

# CORS
# For local development
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173
# For production (Railway) - set this in Railway environment variables
CORS_ORIGIN=https://ev-charger-production.up.railway.app

# Logging
LOG_LEVEL=info

# CPO Integration - EVAN (OCPI)
EVAN_API_BASE_URL=https://api.evan.am
EVAN_API_TOKEN=your-evan-token

# CPO Integration - EcoCars
ECOCARS_API_BASE_URL=https://api.ecocars.am
ECOCARS_API_KEY=your-ecocars-api-key

# Payment Gateways (to be configured)
IDRAM_MERCHANT_ID=
IDRAM_SECRET_KEY=

# SMS Provider (for OTP verification)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Feature Flags
ENABLE_REAL_CPO_INTEGRATION=false
ENABLE_PAYMENT_GATEWAY=false
ENABLE_SMS_VERIFICATION=false

# Monitoring (optional)
SENTRY_DSN=
