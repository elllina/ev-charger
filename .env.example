# Docker Compose Environment Variables

# Database
DB_PASSWORD=postgres
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-in-production-use-very-long-random-string
LOG_LEVEL=info
CORS_ORIGIN=*

# pgAdmin (optional)
PGADMIN_EMAIL=admin@evcharging.am
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
