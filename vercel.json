{
  "version": 2,
  "name": "ev-charging-armenia",
  "builds": [
    {
      "src": "backend/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "backend/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "backend/src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info"
  },
  "regions": ["cdg1"],
  "functions": {
    "backend/src/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
